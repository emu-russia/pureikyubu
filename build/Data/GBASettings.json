	"input":
	{
		"A": "X",
		"B": "Z",
		"SELECT": "Backspace",
		"START": "Return",
		"RIGHT": "Right",
		"LEFT": "Left",
		"UP": "Up",
		"DOWN": "Down",
		"R": "S",
		"L": "A",
		"SPEED": "Space"
	},

	"link":
	{
		"linkEnabled": false,
		"linkServer": false,
		"linkAddress": "127.0.0.1:33333",
		"linkPlayers": 2
	},

	"emulation":
	{
		"rtcEnabled": true,
		"bootWithNoCartridge": false,
		"saveDirectory": "",
