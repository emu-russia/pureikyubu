{
	"info":
	{
		"description": "The GBA emulator's configuration. These are the shipped defaults; a user's file is merged over them, so a member that is missing keeps its default."
	},

	"boot":
	{
		"biosPath": "",
		"useCustomBootRom": true,
		"skipBootAnimation": false,
		"hleBios": true
	},

